.login .input { margin-top: 20rpx; }

.navbar { white-space: nowrap; margin-bottom: 24rpx; display: flex; }
.nav { display: inline-block; padding: 16rpx 28rpx; margin-right: 14rpx; background: var(--card); border-radius: 999rpx; font-size: 27rpx; color: var(--text-soft); }
.nav.on { background: var(--brand); color: #fff; font-weight: 600; }

.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; margin-bottom: 24rpx; }
.stat { background: var(--card); border-radius: 18rpx; padding: 34rpx 28rpx; box-shadow: 0 6rpx 22rpx rgba(120,30,30,.06); }
.stat-num { font-size: 56rpx; font-weight: 800; color: var(--brand); }
.stat-num.warn { color: var(--warn); }
.stat-num.bad { color: var(--bad); }
.stat-label { font-size: 25rpx; color: var(--text-soft); margin-top: 6rpx; }

.filter { display: flex; gap: 14rpx; margin-bottom: 20rpx; align-items: center; }
.filter .input { flex: 1; }
.chk { padding: 18rpx 24rpx; background: var(--card); border-radius: 14rpx; font-size: 26rpx; color: var(--text-soft); white-space: nowrap; }
.chk.on { background: var(--bad); color: #fff; }

.row-head { display: flex; align-items: center; justify-content: space-between; }
.b { font-weight: 700; font-size: 30rpx; }
.bad { color: var(--bad); }
.note { margin-top: 10rpx; font-size: 26rpx; color: var(--text-soft); }
.items { margin-top: 12rpx; display: flex; flex-direction: column; gap: 6rpx; }
.bad-item { color: var(--bad); font-size: 26rpx; }

.seg { display: flex; background: var(--card); border-radius: 14rpx; padding: 8rpx; margin-bottom: 22rpx; }
.seg-i { flex: 1; text-align: center; padding: 16rpx 0; font-size: 27rpx; color: var(--text-soft); border-radius: 10rpx; }
.seg-i.on { background: var(--brand); color: #fff; font-weight: 600; }

.sug-content { margin-top: 14rpx; font-size: 28rpx; white-space: pre-wrap; }
.mini-btn { margin-top: 16rpx; background: var(--brand); color: #fff; font-size: 25rpx; padding: 12rpx 0; border-radius: 12rpx; }
.mini-btn::after { border: none; }

.exam-row, .ded-row, .list-row { display: flex; align-items: center; justify-content: space-between; }
.score { font-size: 48rpx; font-weight: 800; }
.score.ok { color: var(--ok); }
.score.bad { color: var(--bad); }
.del { color: var(--bad); font-size: 26rpx; padding: 8rpx 16rpx; }
.q-mini { flex: 1; font-size: 27rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mt { margin-top: 16rpx; }
.type-sel { display: flex; gap: 14rpx; margin-top: 12rpx; }
.type-i { padding: 14rpx 36rpx; border: 2rpx solid var(--line); border-radius: 12rpx; font-size: 27rpx; color: var(--text-soft); }
.type-i.on { border-color: var(--brand); color: var(--brand); background: rgba(154,31,36,.06); }
