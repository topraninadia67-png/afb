.summary {
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff; border-radius: 20rpx; padding: 40rpx 36rpx; margin-bottom: 24rpx;
}
.sum-name { font-size: 34rpx; font-weight: 700; }
.sum-total { margin-top: 12rpx; font-size: 28rpx; opacity: .9; }
.sum-total .num { font-size: 48rpx; font-weight: 800; color: var(--gold); padding: 0 8rpx; }

.ded-head { display: flex; align-items: center; justify-content: space-between; }
.ded-points { color: var(--bad); font-size: 34rpx; font-weight: 800; }
.ded-reason { margin-top: 12rpx; font-size: 28rpx; color: #38332f; }
